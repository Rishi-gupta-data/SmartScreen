# SmartScreen Environment Configuration

# Database Configuration
# For development: SQLite (default)
# For production: PostgreSQL via Neon or similar
DATABASE_URL=sqlite:///./smartscreen.db
# DATABASE_URL=postgresql://user:password@localhost:5432/smartscreen
# DATABASE_URL=postgresql://user:password@db.neon.tech:5432/smartscreen?sslmode=require

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars!!!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development  # or production

# CORS Configuration (for frontend - update in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# Payment Gateway (Razorpay - for future integration)
# RAZORPAY_KEY_ID=your_key_id
# RAZORPAY_KEY_SECRET=your_key_secret

# LLM Configuration (for future - Hugging Face models only)
# NO EXTERNAL LLM APIS - Only local/self-hosted models allowed
# MODEL_NAME=mistralai/Mistral-7B-Instruct
# MODEL_PATH=/models/mistral
# DEVICE=cpu  # or cuda if GPU available
# HF_TOKEN=your_huggingface_token

# Logging
LOG_LEVEL=INFO

# Credit System Configuration
RESUME_PARSE_CREDITS=5
JD_PARSE_CREDITS=3
MATCH_CREDITS=5
