# ================================
# SmartScreen Environment Config
# ================================

# ----------------
# DATABASE CONFIG
# ----------------
# Development (SQLite - simple local setup)
DATABASE_URL=sqlite:///./smartscreen.db

# Production (PostgreSQL - Neon / Supabase / AWS RDS)
# DATABASE_URL=postgresql://user:password@localhost:5432/smartscreen
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ----------------
# JWT / AUTH CONFIG
# ----------------
# Secret key for signing tokens (⚠️ MUST change in production)
SECRET_KEY=your-super-secret-key-min-32-characters

# JWT signing algorithm
JWT_ALGORITHM=HS256

# Token expiry (in hours)
JWT_EXPIRATION_HOURS=24

# ----------------
# API CONFIG
# ----------------
API_HOST=0.0.0.0
API_PORT=8000

# Environment mode
# development → enables docs, debug logs
# production → disables debug features
ENVIRONMENT=development

# ----------------
# CORS CONFIG
# ----------------
# Allowed frontend origins
# Dev (comma-separated OR JSON format supported)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Recommended (Production JSON format)
# CORS_ORIGINS=["https://yourfrontend.com","https://admin.yourapp.com"]

# ----------------
# LOGGING
# ----------------
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ----------------
# CREDIT SYSTEM
# ----------------
# Credits consumed per action
RESUME_PARSE_CREDITS=5
JD_PARSE_CREDITS=3
MATCH_CREDITS=5
BULK_ANALYSIS_CREDITS=20

# ----------------
# PAYMENT (OPTIONAL)
# ----------------
# Razorpay (India)
# RAZORPAY_KEY_ID=your_key_id
# RAZORPAY_KEY_SECRET=your_key_secret

# Stripe (Global)
# STRIPE_SECRET_KEY=your_stripe_secret
# PAYMENT_WEBHOOK_SECRET=your_webhook_secret

# ----------------
# MONITORING (OPTIONAL)
# ----------------
# Sentry for error tracking
# SENTRY_DSN=your_sentry_dsn

# Azure App Insights
# APP_INSIGHTS_KEY=your_key

# ----------------
# LLM CONFIG (FUTURE - SELF HOSTED ONLY)
# ----------------
# MODEL_NAME=mistralai/Mistral-7B-Instruct
# MODEL_PATH=/models/mistral
# DEVICE=cpu  # or cuda
# HF_TOKEN=your_huggingface_token