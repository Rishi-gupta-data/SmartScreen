# Example environment variables for SmartScreen
# Replace with values from your Neon (or other Postgres) provider

# Example Neon/Postgres connection string (replace placeholders):
# DATABASE_URL=postgresql://<user>:<password>@ep-example-000000.us-east-1-1.neon.tech:5432/smartscreen?sslmode=require

DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
SECRET_KEY=please-change-this-secret
